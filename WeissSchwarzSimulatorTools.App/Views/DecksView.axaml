<!--
  The Decks screen: the decks saved in the simulator on the left (a tree of their folders), the open
  deck in the middle (its stats and cards), the hovered card on the right. While a deck is being built, the deck editor
  takes the whole screen.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeissSchwarzSimulatorTools.App.ViewModels"
             xmlns:v="using:WeissSchwarzSimulatorTools.App.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="WeissSchwarzSimulatorTools.App.Views.DecksView"
             x:DataType="vm:DecksViewModel"
             x:Name="Root">
  <Panel>
    <!-- The deck editor. -->
    <v:CardBrowserView DataContext="{Binding Editor.Browser, FallbackValue={x:Null}}" IsVisible="{Binding #Root.((vm:DecksViewModel)DataContext).IsEditing}">
      <v:CardBrowserView.SideContent>
        <v:DeckEditorPanel DataContext="{Binding #Root.((vm:DecksViewModel)DataContext).Editor}" />
      </v:CardBrowserView.SideContent>
    </v:CardBrowserView>

    <DockPanel IsVisible="{Binding IsBrowsing}">
      <!-- The deck list: the tree of the Decks folder, then the AI opponents. -->
      <Border DockPanel.Dock="Left" Width="320" Margin="16,16,8,16" Classes="card" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8">
            <DockPanel>
              <Button Classes="text" DockPanel.Dock="Right" Command="{Binding ToggleSortCommand}" ToolTip.Tip="{Binding SortTip}">
                <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="Sort" /><TextBlock Text="{Binding SortLabel}" /></StackPanel>
              </Button>
              <Button Classes="icon" DockPanel.Dock="Right" Command="{Binding NewFolderCommand}" ToolTip.Tip="{Binding NewFolderTip}">
                <mi:MaterialIcon Kind="FolderPlusOutline" />
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
                <TextBlock Classes="headline" Text="Decks" />
                <TextBlock Classes="label muted" Text="{Binding OwnCount}" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
            <UniformGrid Columns="2">
              <Button Classes="filled" Command="{Binding NewDeckCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" Padding="8,0"
                      ToolTip.Tip="{Binding CurrentFolderText, StringFormat='Build a new deck in {0}'}">
                <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="PlusThick" /><TextBlock Text="New deck" /></StackPanel>
              </Button>
              <Button Classes="tonal" Command="{Binding ImportCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,0" Padding="8,0"
                      ToolTip.Tip="{Binding ImportTip}">
                <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="Download" /><TextBlock Text="Import" /></StackPanel>
              </Button>
            </UniformGrid>
            <!-- The current folder: where new decks, imports and new folders go. A segment goes back to that folder. -->
            <DockPanel Margin="4,0,0,0" ToolTip.Tip="New decks, imports and new folders go to this folder">
              <mi:MaterialIcon Kind="FolderOpenOutline" DockPanel.Dock="Left" Width="18" Height="18" Classes="muted" Margin="0,0,4,0" />
              <ItemsControl ItemsSource="{Binding Crumbs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FolderCrumb">
                    <StackPanel Orientation="Horizontal">
                      <Button Classes="crumb" Classes.last="{Binding IsLast}" Content="{Binding Name}" Command="{Binding Go}" />
                      <TextBlock Classes="bodySmall muted" Text="›" VerticalAlignment="Center" Margin="2,0" IsVisible="{Binding HasSeparator}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
            <TextBox Classes="search" Watermark="Find a deck" Text="{Binding Query}" IsVisible="{Binding ShowSearch}" />
          </StackPanel>
          <Panel Margin="0,8,0,0">
            <TextBlock Classes="muted wrap" Text="{Binding EmptyText}" IsVisible="{Binding NoDecks}" Margin="8,16" />
            <TextBlock Classes="muted wrap" Text="No deck matches." IsVisible="{Binding NoMatch}" Margin="8,16" />
            <ScrollViewer IsVisible="{Binding HasDecks}">
              <StackPanel Margin="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.DataTemplates>
                    <!-- A folder: a click opens or closes it; its menu (or a right-click) manages it. -->
                    <DataTemplate DataType="vm:FolderRow">
                      <Button Classes="row" Classes.current="{Binding IsCurrent}" Command="{Binding Toggle}" Padding="8,6,4,6">
                        <Button.ContextFlyout>
                          <MenuFlyout>
                            <MenuItem Header="New folder inside" Command="{Binding NewFolder}" Icon="{mi:MaterialIconExt Kind=FolderPlusOutline}" />
                            <MenuItem Header="Rename…" Command="{Binding Rename}" Icon="{mi:MaterialIconExt Kind=PencilOutline}" />
                            <MenuItem Header="Move to…" Command="{Binding Move}" Icon="{mi:MaterialIconExt Kind=FolderMoveOutline}" />
                            <MenuItem Header="Delete" Command="{Binding Delete}" Icon="{mi:MaterialIconExt Kind=DeleteOutline}" />
                          </MenuFlyout>
                        </Button.ContextFlyout>
                        <DockPanel>
                          <Border DockPanel.Dock="Left" Width="{Binding IndentWidth}" />
                          <Panel DockPanel.Dock="Left" Width="20" Margin="0,0,2,0">
                            <mi:MaterialIcon Kind="ChevronRight" Width="18" Height="18" Classes="muted" IsVisible="{Binding Collapsed}" />
                            <mi:MaterialIcon Kind="ChevronDown" Width="18" Height="18" Classes="muted" IsVisible="{Binding Expanded}" />
                          </Panel>
                          <Panel DockPanel.Dock="Left" Margin="0,0,8,0">
                            <mi:MaterialIcon Kind="FolderOutline" Width="20" Height="20" Classes="primary" IsVisible="{Binding Collapsed}" />
                            <mi:MaterialIcon Kind="FolderOpenOutline" Width="20" Height="20" Classes="primary" IsVisible="{Binding Expanded}" />
                          </Panel>
                          <Button Classes="icon small" DockPanel.Dock="Right" ToolTip.Tip="Folder actions">
                            <mi:MaterialIcon Kind="DotsVertical" />
                            <Button.Flyout>
                              <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="New folder inside" Command="{Binding NewFolder}" Icon="{mi:MaterialIconExt Kind=FolderPlusOutline}" />
                                <MenuItem Header="Rename…" Command="{Binding Rename}" Icon="{mi:MaterialIconExt Kind=PencilOutline}" />
                                <MenuItem Header="Move to…" Command="{Binding Move}" Icon="{mi:MaterialIconExt Kind=FolderMoveOutline}" />
                                <MenuItem Header="Delete" Command="{Binding Delete}" Icon="{mi:MaterialIconExt Kind=DeleteOutline}" />
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                          <TextBlock Classes="label muted" DockPanel.Dock="Right" Text="{Binding CountText}" VerticalAlignment="Center" Margin="8,0,4,0" />
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                      </Button>
                    </DataTemplate>
                    <!-- A deck: a click opens it; a right-click moves it. -->
                    <DataTemplate DataType="vm:DeckRow">
                      <Button Classes="row" Classes.selected="{Binding IsSelected}" Command="{Binding Open}">
                        <Button.ContextFlyout>
                          <MenuFlyout>
                            <MenuItem Header="Move to…" Command="{Binding Move}" Icon="{mi:MaterialIconExt Kind=FolderMoveOutline}" />
                          </MenuFlyout>
                        </Button.ContextFlyout>
                        <DockPanel>
                          <Border DockPanel.Dock="Left" Width="{Binding IndentWidth}" />
                          <StackPanel>
                            <TextBlock Text="{Binding Item.Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="bodySmall muted" Text="{Binding Item.Supporting}" />
                            <TextBlock Classes="bodySmall muted" Text="{Binding Item.FolderText}" IsVisible="{Binding Item.HasFolder}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="bodySmall muted" Text="{Binding Item.TagsText}" IsVisible="{Binding Item.HasTags}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DockPanel>
                      </Button>
                    </DataTemplate>
                    <DataTemplate DataType="vm:EmptyFolderRow">
                      <DockPanel Margin="8,4,8,8">
                        <Border DockPanel.Dock="Left" Width="{Binding IndentWidth}" />
                        <TextBlock Classes="bodySmall muted" Text="Empty folder" Margin="22,0,0,0" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.DataTemplates>
                </ItemsControl>
                <TextBlock Classes="label muted" Text="AI opponents" Margin="16,12,0,2" IsVisible="{Binding HasAiDecks}" />
                <ListBox Classes="plain rows" ItemsSource="{Binding AiDecks}" SelectedItem="{Binding SelectedAi}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeckItem">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="bodySmall muted" Text="{Binding Supporting}" />
                        <TextBlock Classes="bodySmall muted" Text="{Binding FolderText}" IsVisible="{Binding HasFolder}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </Border>

      <!-- The hovered card. -->
      <v:DetailPaneView DockPanel.Dock="Right" Width="380" Margin="8,16,16,16"
                        DataContext="{Binding Picked.Preview.Pane, FallbackValue={x:Null}}" IsVisible="{Binding #Root.((vm:DecksViewModel)DataContext).HasPicked}" />

      <!-- The open deck. -->
      <Panel Margin="12,16,8,0">
        <StackPanel IsVisible="{Binding NothingPicked}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
          <mi:MaterialIcon Kind="Layers" Width="48" Height="48" Foreground="{DynamicResource Outline}" />
          <TextBlock Classes="title" Text="Pick a deck" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" Text="Choose a deck on the left, build a new one, or import one from Encore Decks." HorizontalAlignment="Center" />
        </StackPanel>
        <ScrollViewer IsVisible="{Binding HasPicked}">
          <StackPanel Spacing="8" DataContext="{Binding Picked}" x:DataType="vm:PickedDeckViewModel">
            <TextBlock Classes="headline wrap" Text="{Binding Name}" />
            <TextBlock Classes="muted" Text="{Binding SavedText}" IsVisible="{Binding HasDate}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="FolderOutline" Width="16" Height="16" Classes="muted" />
              <TextBlock Classes="bodySmall muted" Text="{Binding FolderText}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="bodySmall muted" Text="Sleeve" VerticalAlignment="Center" />
              <v:SleevePickerView DataContext="{Binding Sleeves}" IsVisible="{Binding $parent[StackPanel].((vm:PickedDeckViewModel)DataContext).IsOwn}" />
              <TextBlock Classes="muted" Text="{Binding AiSleeve}" IsVisible="{Binding IsAi}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTags}">
              <TextBlock Classes="bodySmall muted" Text="Tags" VerticalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Classes="chip" Margin="0,0,6,0"><TextBlock Classes="label" Text="{Binding}" /></Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <WrapPanel Margin="0,4,0,0">
              <WrapPanel.Styles>
                <Style Selector="Button">
                  <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
              </WrapPanel.Styles>
              <Button Classes="tonal" Command="{Binding #Root.((vm:DecksViewModel)DataContext).EditCommand}" IsVisible="{Binding IsOwn}">
                <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="PencilOutline" /><TextBlock Text="Edit" /></StackPanel>
              </Button>
              <Button Classes="outlined" Command="{Binding #Root.((vm:DecksViewModel)DataContext).MoveCommand}" IsVisible="{Binding IsOwn}"
                      ToolTip.Tip="Move this deck to another folder">
                <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="FolderMoveOutline" /><TextBlock Text="Move" /></StackPanel>
              </Button>
              <Button Classes="outlined" Command="{Binding #Root.((vm:DecksViewModel)DataContext).DuplicateCommand}" ToolTip.Tip="Build a new deck starting from this one">
                <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="ContentCopy" /><TextBlock Text="Duplicate" /></StackPanel>
              </Button>
              <Button Classes="outlined" Command="{Binding #Root.((vm:DecksViewModel)DataContext).UploadCommand}" ToolTip.Tip="Publish this deck on Encore Decks">
                <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="CloudUpload" /><TextBlock Text="Upload" /></StackPanel>
              </Button>
              <Button Classes="outlined" Command="{Binding #Root.((vm:DecksViewModel)DataContext).PrintProxiesCommand}" ToolTip.Tip="PDF of the deck's cards at real size, to print and cut out">
                <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Printer" /><TextBlock Text="Proxies" /></StackPanel>
              </Button>
              <Button Classes="outlined" Command="{Binding #Root.((vm:DecksViewModel)DataContext).PrintTranslationCommand}" ToolTip.Tip="PDF of the cards with their English text">
                <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Translate" /><TextBlock Text="Translation" /></StackPanel>
              </Button>
            </WrapPanel>
            <v:DeckPreviewView DataContext="{Binding Preview}" />
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </DockPanel>
  </Panel>
</UserControl>
