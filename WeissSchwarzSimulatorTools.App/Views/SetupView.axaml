<!-- The first screen: asks where the simulator is installed, then loads its cards. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeissSchwarzSimulatorTools.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="WeissSchwarzSimulatorTools.App.Views.SetupView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <Border Classes="card" Padding="32" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,48">
      <StackPanel Spacing="4">
        <mi:MaterialIcon Kind="CardsOutline" Width="44" Height="44" Classes="primary" HorizontalAlignment="Center" />
        <TextBlock Classes="headline" Text="WeissSchwarzSimulatorTools" HorizontalAlignment="Center" />
        <TextBlock Classes="muted wrap" TextAlignment="Center"
                   Text="Browse the Weiss Schwarz Simulator cards, review your decks and import decks from Encore Decks." />

        <!-- Loading the cards. -->
        <StackPanel IsVisible="{Binding Setup.IsLoading}" Spacing="8" Margin="0,24,0,0" HorizontalAlignment="Center">
          <Arc Classes="spinner" Width="36" Height="36" />
          <TextBlock Classes="titleMedium" Text="Loading cards…" HorizontalAlignment="Center" />
          <TextBlock Classes="muted bodySmall" Text="{Binding Setup.LoadingPath}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- The folder form. -->
        <StackPanel IsVisible="{Binding Setup.IsForm}" Spacing="8" Margin="0,24,0,0">
          <TextBlock Classes="titleMedium" Text="Simulator folder" />
          <TextBlock Classes="muted wrap"
                     Text="The folder where the simulator is installed, the one that contains CardContent and Decks. You only need to set it once." />
          <TextBox Text="{Binding Setup.PathInput}" Watermark="{Binding Setup.Hint}" KeyDown="OnPathKeyDown">
            <TextBox.InnerLeftContent>
              <mi:MaterialIcon Kind="FolderOutline" Width="20" Height="20" Classes="muted" Margin="8,0,0,0" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <mi:MaterialIcon Kind="CheckCircle" Width="16" Height="16" Classes="success" IsVisible="{Binding Setup.StatusOk}" />
            <mi:MaterialIcon Kind="AlertCircle" Width="16" Height="16" Classes="error" IsVisible="{Binding Setup.StatusError}" />
            <TextBlock Classes="bodySmall muted" Text="{Binding Setup.StatusText}" IsVisible="{Binding Setup.StatusNeutral}" TextWrapping="Wrap" />
            <TextBlock Classes="bodySmall success" Text="{Binding Setup.StatusText}" IsVisible="{Binding Setup.StatusOk}" TextWrapping="Wrap" />
            <TextBlock Classes="bodySmall error" Text="{Binding Setup.StatusText}" IsVisible="{Binding Setup.StatusError}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel IsVisible="{Binding Setup.ShowDetected}" Spacing="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="label muted" Text="Found on this computer" VerticalAlignment="Center" />
              <Arc Classes="spinner" Width="14" Height="14" StrokeThickness="2" IsVisible="{Binding Setup.Detecting}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Setup.Detected}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DetectedInstall">
                  <Button Classes="text" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,8" Height="NaN"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PickDetectedCommand}" CommandParameter="{Binding}">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                      <TextBlock Classes="bodySmall muted" Text="{Binding Parent}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Button Classes="filled" HorizontalAlignment="Right" Margin="0,20,0,0"
                  IsEnabled="{Binding Setup.CanLoad}" Command="{Binding LoadFromSetupCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="FolderOpen" />
              <TextBlock Text="Load simulator" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
