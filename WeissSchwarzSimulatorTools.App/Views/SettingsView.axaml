<!-- The Settings screen: theme, simulator folder, decks folder, Encore Decks account, version. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeissSchwarzSimulatorTools.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="WeissSchwarzSimulatorTools.App.Views.SettingsView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer Padding="24">
    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Classes="headline" Text="Settings" Margin="0,0,0,4" />

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="titleMedium" Text="Appearance" />
          <TextBlock Classes="muted" Text="Theme" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button MinWidth="120" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static vm:ThemeChoice.System}"
                    Classes.tonal="{Binding IsSystemTheme}" Classes.outlined="{Binding !IsSystemTheme}">
              <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="BrightnessAuto" /><TextBlock Text="System" /></StackPanel>
            </Button>
            <Button MinWidth="120" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static vm:ThemeChoice.Light}"
                    Classes.tonal="{Binding IsLightTheme}" Classes.outlined="{Binding !IsLightTheme}">
              <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="WeatherSunny" /><TextBlock Text="Light" /></StackPanel>
            </Button>
            <Button MinWidth="120" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static vm:ThemeChoice.Dark}"
                    Classes.tonal="{Binding IsDarkTheme}" Classes.outlined="{Binding !IsDarkTheme}">
              <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="WeatherNight" /><TextBlock Text="Dark" /></StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="titleMedium" Text="Simulator" />
          <SelectableTextBlock Classes="muted wrap" FontFamily="monospace" Text="{Binding SimulatorPath}" />
          <WrapPanel>
            <Border Classes="chip" Margin="0,0,6,0"><TextBlock Classes="label" Text="{Binding SeriesText}" /></Border>
            <Border Classes="chip" Margin="0,0,6,0"><TextBlock Classes="label" Text="{Binding SetsText}" /></Border>
            <Border Classes="chip"><TextBlock Classes="label" Text="{Binding CardsText}" /></Border>
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Classes="tonal" Command="{Binding ReloadCardsCommand}" IsEnabled="{Binding CanReload}"
                    ToolTip.Tip="Read the card data again, e.g. after a simulator update">
              <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Reload" /><TextBlock Text="Reload cards" /></StackPanel>
            </Button>
            <Arc Classes="spinner" IsVisible="{Binding Loading}" />
            <Button Classes="outlined" Command="{Binding UnloadSimulatorCommand}" ToolTip.Tip="Forget this folder and pick another one">
              <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="FolderOpen" /><TextBlock Text="Change folder…" /></StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="titleMedium" Text="Simulator decks" />
          <SelectableTextBlock Classes="muted wrap" FontFamily="monospace" Text="{Binding DecksPath}" />
          <TextBlock Classes="bodySmall muted wrap" Text="{Binding DecksFolderText}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="titleMedium" Text="Encore Decks account" />
          <!-- Linked. -->
          <StackPanel Spacing="6" IsVisible="{Binding Account.IsLinked}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="AccountCircle" Width="20" Height="20" Classes="primary" />
              <TextBlock Text="{Binding Account.LinkedText}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="bodySmall muted" Text="Uploaded decks are saved in this account." />
            <Button Classes="outlined" Command="{Binding Account.UnlinkCommand}" ToolTip.Tip="Sign out and upload anonymously again" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Logout" /><TextBlock Text="Unlink" /></StackPanel>
            </Button>
          </StackPanel>
          <!-- Reading the saved session. -->
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Account.Restoring}">
            <Arc Classes="spinner" />
            <TextBlock Classes="muted" Text="Reading the session from the system keyring…" VerticalAlignment="Center" />
          </StackPanel>
          <!-- Sign-in form. -->
          <StackPanel Spacing="8" IsVisible="{Binding Account.ShowForm}">
            <TextBlock Classes="bodySmall muted wrap"
                       Text="Sign in to upload decks to your account, where you can edit or delete them. Without an account, decks are uploaded anonymously. Your password is never stored: it is sent once over HTTPS. The session is kept encrypted in the system keyring (Secret Service / KWallet, Windows Credential Manager), never in the settings file." />
            <WrapPanel>
              <TextBox Width="240" Watermark="Email" Text="{Binding Account.Email}" IsEnabled="{Binding !Account.SigningIn}" Margin="0,0,8,8" />
              <TextBox Width="200" Watermark="Password" PasswordChar="•" Text="{Binding Account.Password}" IsEnabled="{Binding !Account.SigningIn}"
                       Margin="0,0,8,8" KeyDown="OnPasswordKeyDown" />
              <Button Classes="tonal" Command="{Binding Account.LinkCommand}" IsEnabled="{Binding Account.CanLink}" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Login" /><TextBlock Text="Link account" /></StackPanel>
              </Button>
              <Arc Classes="spinner" IsVisible="{Binding Account.SigningIn}" Margin="0,8,0,0" />
            </WrapPanel>
          </StackPanel>
          <TextBlock Classes="bodySmall error wrap" Text="{Binding Account.Error}" IsVisible="{Binding Account.HasError}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="titleMedium" Text="About" />
          <SelectableTextBlock Classes="muted wrap" Text="{Binding AboutText}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
