<!-- The side pane showing one card in full: the hovered one, or the one pinned by a click. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimuDeckParser.App.ViewModels"
             xmlns:ctl="using:SimuDeckParser.App.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="SimuDeckParser.App.Views.DetailPaneView"
             x:DataType="vm:DetailPaneViewModel">
  <Border Classes="card" Padding="16,12">
    <Panel>
      <StackPanel IsVisible="{Binding !HasCard}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
        <mi:MaterialIcon Kind="GestureTap" Width="40" Height="40" Foreground="{DynamicResource Outline}" />
        <TextBlock Classes="titleMedium" Text="No card selected" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="{Binding EmptyText}" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <ScrollViewer IsVisible="{Binding HasCard}">
        <StackPanel Spacing="4">
          <DockPanel>
            <Button Classes="icon small" DockPanel.Dock="Right" Command="{Binding UnpinCommand}" IsVisible="{Binding Pinned}" ToolTip.Tip="Unpin (Esc)">
              <mi:MaterialIcon Kind="PinOff" />
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <mi:MaterialIcon Kind="Pin" Width="18" Height="18" Classes="muted" IsVisible="{Binding Pinned}" />
              <mi:MaterialIcon Kind="CardsOutline" Width="18" Height="18" Classes="muted" IsVisible="{Binding !Pinned}" />
              <TextBlock Classes="label muted" Text="{Binding StateText}" />
            </StackPanel>
          </DockPanel>
          <Border CornerRadius="12" ClipToBounds="True" HorizontalAlignment="Center" MaxWidth="340" Margin="0,4,0,8">
            <Image Stretch="Uniform" ctl:Pictures.DecodeWidth="480" ctl:Pictures.Path="{Binding Card.Image, FallbackValue={x:Null}}" />
          </Border>
          <ctl:CardSummaryView Card="{Binding Card}" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPicking}" Margin="0,4,0,0">
            <Button Classes="tonal" Command="{Binding AddCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="PlusThick" /><TextBlock Text="Add" /></StackPanel>
            </Button>
            <Button Classes="text" Command="{Binding RemoveCommand}" IsVisible="{Binding InDeck}">
              <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="MinusThick" /><TextBlock Text="Remove" /></StackPanel>
            </Button>
            <TextBlock Classes="label primary" Text="{Binding CopiesText}" IsVisible="{Binding InDeck}" VerticalAlignment="Center" />
          </StackPanel>
          <Button Classes="tonal" Command="{Binding ShowRelatedCommand}" Margin="0,8,0,0" ToolTip.Tip="Cards that name this one, and the ones it names">
            <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Hub" /><TextBlock Text="Related cards" /></StackPanel>
          </Button>
          <ctl:EffectTextView Card="{Binding Card}" />
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </Border>
</UserControl>
