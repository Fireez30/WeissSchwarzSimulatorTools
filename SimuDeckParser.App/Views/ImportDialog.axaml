<!-- The Import dialog: paste an Encore Decks link, and the deck is saved in the simulator. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimuDeckParser.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="SimuDeckParser.App.Views.ImportDialog"
             x:DataType="vm:ImportDialogViewModel">
  <StackPanel Width="520" Spacing="8">
    <mi:MaterialIcon Kind="Download" Width="28" Height="28" Classes="primary" />
    <TextBlock Classes="headline" Text="Import from Encore Decks" HorizontalAlignment="Center" />
    <TextBlock Classes="muted wrap"
               Text="Paste the link of an Encore Decks deck. It is added to the simulator's deck list; codes are matched to the loaded cards (JP/EN, foil or not)." />
    <TextBox Name="Link" Text="{Binding Link}" Watermark="https://www.encoredecks.com/deck/…" IsEnabled="{Binding IsIdle}" Margin="0,4,0,0"
             AttachedToVisualTree="OnLinkAttached" KeyDown="OnLinkKeyDown">
      <TextBox.InnerLeftContent>
        <mi:MaterialIcon Kind="Link" Width="20" Height="20" Classes="muted" Margin="8,0,0,0" />
      </TextBox.InnerLeftContent>
    </TextBox>
    <Panel>
      <TextBlock Classes="bodySmall muted" Text="{Binding Hint}" IsVisible="{Binding !Link.Length}" />
      <TextBlock Classes="bodySmall success" Text="{Binding Hint}" IsVisible="{Binding HintOk}" />
      <TextBlock Classes="bodySmall error" Text="{Binding Hint}" IsVisible="{Binding HintError}" />
    </Panel>
    <TextBlock Classes="bodySmall muted wrap"
               Text="The deck is saved as a new file in the simulator's Decks folder; existing decks are never overwritten." />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Running}">
        <TextBlock Classes="muted" Text="Importing…" VerticalAlignment="Center" />
        <Arc Classes="spinner" />
      </StackPanel>
      <Button Classes="text" Content="Cancel" Command="{Binding CloseCommand}" IsVisible="{Binding IsIdle}" />
      <Button Classes="filled" Content="Import" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" IsVisible="{Binding IsIdle}" />
    </StackPanel>
  </StackPanel>
</UserControl>
