<!--
  The sleeve picker: a button showing the deck's sleeve, which opens a popup with every sleeve of
  the simulator as thumbnails, a name filter, and a form to add a new sleeve from a file or a link.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimuDeckParser.App.ViewModels"
             xmlns:ctl="using:SimuDeckParser.App.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="SimuDeckParser.App.Views.SleevePickerView"
             x:DataType="vm:SleevePickerViewModel">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <Border CornerRadius="3" ClipToBounds="True" IsVisible="{Binding HasCurrent}" VerticalAlignment="Center">
      <Image Width="18" Height="25" ctl:Pictures.DecodeWidth="40" ctl:Pictures.Placeholder="False" ctl:Pictures.Path="{Binding CurrentPath}" />
    </Border>
    <ToggleButton Classes="field" IsChecked="{Binding IsOpen}" MinWidth="200" MaxWidth="260"
                  ToolTip.Tip="The image the simulator puts the deck's cards in">
      <DockPanel>
        <mi:MaterialIcon Kind="ChevronDown" Width="18" Height="18" DockPanel.Dock="Right" />
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
    </ToggleButton>
    <Popup IsOpen="{Binding IsOpen}" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True"
           PlacementTarget="{Binding $parent[StackPanel]}">
      <Border Background="{DynamicResource SurfaceContainer}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1"
              CornerRadius="12" Padding="12" Width="504" BoxShadow="0 3 12 0 #40000000">
        <StackPanel Spacing="8">
          <TextBox Name="Filter" Watermark="Find a sleeve" Text="{Binding Query}" />
          <Button Classes="text" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding PickNoneCommand}"
                  ToolTip.Tip="The deck is played without a sleeve">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="Check" IsVisible="{Binding NoSleeveSelected}" />
              <TextBlock Text="No sleeve" />
            </StackPanel>
          </Button>
          <Separator />
          <ScrollViewer Height="440">
            <Panel>
              <TextBlock Classes="muted" Text="{Binding NoMatchText}" IsVisible="{Binding NoMatch}" />
              <ItemsControl ItemsSource="{Binding Shown}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SleeveItemViewModel">
                    <Button Background="Transparent" Padding="2" Margin="0,0,8,8" Width="88" Cursor="Hand"
                            Command="{Binding $parent[UserControl].((vm:SleevePickerViewModel)DataContext).PickCommand}" CommandParameter="{Binding}">
                      <ToolTip.Tip>
                        <ToolTip Classes="rich">
                          <Image Width="160" Height="224" ctl:Pictures.DecodeWidth="240" ctl:Pictures.Path="{Binding Path}" />
                        </ToolTip>
                      </ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <Border CornerRadius="6" ClipToBounds="True" BorderThickness="2"
                                BorderBrush="{DynamicResource Primary}" Classes.selected="{Binding Selected}">
                          <Border.Styles>
                            <Style Selector="Border:not(.selected)">
                              <Setter Property="BorderBrush" Value="Transparent" />
                            </Style>
                          </Border.Styles>
                          <Image Width="80" Height="112" ctl:Pictures.DecodeWidth="120" ctl:Pictures.Path="{Binding Path}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis" Classes="muted" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>
          <Separator />
          <TextBlock Classes="label muted" Text="Add a sleeve" />
          <TextBox Watermark="Image path or link (JPEG or PNG)" Text="{Binding Source}" IsEnabled="{Binding !Adding}" KeyDown="OnAddKeyDown" />
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
              <Arc Classes="spinner" IsVisible="{Binding Adding}" />
              <Button Classes="tonal" Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}"
                      ToolTip.Tip="Copy the image into the simulator's Sleeves folder">
                <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="PlusThick" /><TextBlock Text="Add" /></StackPanel>
              </Button>
            </StackPanel>
            <TextBox Watermark="Name (optional)" Text="{Binding Name}" IsEnabled="{Binding !Adding}" KeyDown="OnAddKeyDown" />
          </DockPanel>
          <TextBlock Classes="bodySmall error wrap" Text="{Binding AddError}" IsVisible="{Binding HasAddError}" />
        </StackPanel>
      </Border>
    </Popup>
  </StackPanel>
</UserControl>
