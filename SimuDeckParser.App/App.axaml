<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="SimuDeckParser.App.App"
             Name="SimuDeckParser"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SimuDeckParser/Theme/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="ContentControlThemeFontFamily">fonts:SimuDeckParser#Noto Sans</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#6750A4" RegionColor="#FEF7FF" />
        <ColorPaletteResources x:Key="Dark" Accent="#D0BCFF" RegionColor="#141218" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <mi:MaterialIconStyles />
    <StyleInclude Source="avares://SimuDeckParser/Theme/Material.axaml" />
    <StyleInclude Source="avares://SimuDeckParser/Controls/Controls.axaml" />
  </Application.Styles>
</Application>
