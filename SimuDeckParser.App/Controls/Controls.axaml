<!-- Styles of the program's own controls. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A spinning arc: <Arc Classes="spinner" Width="24" Height="24" /> -->
  <Style Selector="Arc.spinner">
    <Setter Property="Stroke" Value="{DynamicResource Primary}" />
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StartAngle" Value="0" />
    <Setter Property="SweepAngle" Value="270" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="RenderTransform">
      <RotateTransform />
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
